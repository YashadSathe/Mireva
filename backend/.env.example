# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="Mireva"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==============================================================================
# Supabase (PostgreSQL & Storage)
# ==============================================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="documents"
# Supabase PostgreSQL connection string (supports postgresql:// or postgresql+asyncpg://)
# NOTE FOR RENDER / IPv4 PLATFORMS:
# The direct Supabase hostname (db.<project-ref>.supabase.co) resolves to IPv6 only.
# Render runtime environments require IPv4. Use the Supabase Shared Connection Pooler
# in Session Mode (port 5432) which provides an IPv4-reachable endpoint:
# Format: postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Qdrant Vector Store & Indexing
# ==============================================================================
QDRANT_URL="https://[YOUR-CLUSTER-ID].qdrant.tech"
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME="document_chunks"
QDRANT_TIMEOUT=30
QDRANT_VECTOR_SIZE=1024
QDRANT_BATCH_SIZE=64
QDRANT_DISTANCE="Cosine"
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_DELAY=0.5
QDRANT_RETRY_BACKOFF=2.0

# ==============================================================================
# Embeddings Configuration (Cohere Embed v4 / Voyage AI)
# ==============================================================================
EMBEDDING_PROVIDER="cohere"
COHERE_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL="embed-v4.0"

# Redis Cache (Shared embedding result cache)
REDIS_URL="redis://localhost:6379/0"

# LLM Provider for Query Transformation
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL="gpt-4o"
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=0.5
LLM_RETRY_BACKOFF=2.0
LLM_TEMPERATURE=0.0

# Contextual Enrichment (Document-level enrichment before embeddings)
CONTEXTUAL_ENRICHMENT_ENABLED=false
CONTEXTUAL_ENRICHMENT_STRATEGY="structured"

# ==============================================================================
# Retrieval & Query Preprocessing / Transformation
# ==============================================================================
MAX_QUERY_LENGTH=2000
QUERY_TRANSFORMATION_ENABLED=true
QUERY_TRANSFORMATION_STRATEGY="llm_rewrite"
QUERY_TRANSFORMATION_MODEL="gpt-4o"
QUERY_TRANSFORMATION_TIMEOUT=5.0
QUERY_TRANSFORMATION_MAX_RETRIES=1
QUERY_TRANSFORMATION_MAX_FALLBACK_ATTEMPTS=1
QUERY_TRANSFORMATION_BASE_URL=
VECTOR_SEARCH_TOP_K=10
VECTOR_SEARCH_SCORE_THRESHOLD=
SPARSE_INDEXING_ENABLED=true
SPARSE_ENCODER_STRATEGY="technical_hash"
SPARSE_ENCODER_VERSION="1.0"
SPARSE_VECTOR_NAME="sparse"
KEYWORD_SEARCH_TOP_K=10
KEYWORD_SEARCH_SCORE_THRESHOLD=
FUSION_RRF_K=60
FUSION_TOP_K=10
METADATA_FILTERING_ENABLED=true
METADATA_FILTERING_STRICT_MODE=false

# Cross-Encoder Reranking Configuration (Jina Reranker v3.5)
RERANKING_ENABLED=true
RERANKER_PROVIDER="jina"
RERANKER_MODEL="jina-reranker-v3.5"
JINA_API_KEY=
RERANKER_TIMEOUT=15.0
RERANKER_CANDIDATE_LIMIT=50
RERANKER_RESULT_LIMIT=10
